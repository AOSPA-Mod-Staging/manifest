  <!-- Nexus -->
  <project path="build/make" name="android_build" remote="nex" >
    <linkfile src="CleanSpec.mk" dest="build/CleanSpec.mk" />
    <linkfile src="buildspec.mk.default" dest="build/buildspec.mk.default" />
    <linkfile src="core" dest="build/core" />
    <linkfile src="envsetup.sh" dest="build/envsetup.sh" />
    <linkfile src="target" dest="build/target" />
    <linkfile src="tools" dest="build/tools" />
  </project>
  <project path="bootable/recovery" name="android_bootable_recovery" remote="nex" />
  <project path="build/soong" name="android_build_soong" remote="nex" >
    <linkfile src="root.bp" dest="Android.bp" />
    <linkfile src="bootstrap.bash" dest="bootstrap.bash" />
  </project>
  <project path="device/qcom/common" name="android_device_qcom_common" remote="aospam" >
    <linkfile dest="vendor/qcom/build/tasks/generate_extra_images.mk" src="generate_extra_images.mk"/>
  </project>
  <project path="external/tinycompress" name="android_external_tinycompress" remote="aospam" />
  <project path="frameworks/av" name="android_frameworks_av" remote="nex" />
  <project path="frameworks/base" name="android_frameworks_base" remote="nex" />
  <project path="frameworks/native" name="android_frameworks_native" remote="nex" />
  <project path="packages/apps/Launcher3" name="android_packages_apps_Launcher3" remote="nex" />
  <project path="packages/apps/Settings" name="android_packages_apps_Settings" remote="nex" />
  <project path="packages/apps/ThemePicker" name="android_packages_apps_ThemePicker" remote="nex" />
  <project path="packages/resources/devicesettings" name="android_packages_resources_devicesettings" remote="losf" />
  <project path="prebuilts/extract-tools" name="android_prebuilts_extract-tools" remote="los" />
